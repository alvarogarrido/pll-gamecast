{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Helvetica", "Arial", "sans-serif"],
        "$description": "UI text (D4)",
        "$extensions": { "com.pll": { "hostVar": "--font-inter" } }
      },
      "display": {
        "$value": ["Barlow Condensed", "Arial Narrow", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Scores, the clock and big numerals (D4)",
        "$extensions": { "com.pll": { "hostVar": "--font-barlow-condensed" } }
      }
    }
  },
  "text": {
    "$description": "Type scale. Every style has fontFamily, fontSize, lineHeight, fontWeight, letterSpacing. Spec: docs/design-decisions.md.",
    "scoreHero": {
      "$description": "score.hero",
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.display}" },
      "fontSize": { "$type": "dimension", "$value": "48px" },
      "lineHeight": { "$type": "dimension", "$value": "48px" },
      "fontWeight": { "$type": "fontWeight", "$value": 800 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "score": {
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.display}" },
      "fontSize": { "$type": "dimension", "$value": "32px" },
      "lineHeight": { "$type": "dimension", "$value": "32px" },
      "fontWeight": { "$type": "fontWeight", "$value": 800 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "scoreSm": {
      "$description": "score.sm (D14): the minimized header and compact score chips.",
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.display}" },
      "fontSize": { "$type": "dimension", "$value": "24px" },
      "lineHeight": { "$type": "dimension", "$value": "24px" },
      "fontWeight": { "$type": "fontWeight", "$value": 800 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "clock": {
      "$description": "Tabular numerals (tabular-nums is applied by the generated utility).",
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.display}" },
      "fontSize": { "$type": "dimension", "$value": "13px" },
      "lineHeight": { "$type": "dimension", "$value": "16px" },
      "fontWeight": { "$type": "fontWeight", "$value": 600 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" },
      "fontVariantNumeric": { "$type": "string", "$value": "tabular-nums" }
    },
    "title1": {
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "fontSize": { "$type": "dimension", "$value": "28px" },
      "lineHeight": { "$type": "dimension", "$value": "34px" },
      "fontWeight": { "$type": "fontWeight", "$value": 600 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "title3": {
      "$description": "Section headers (apply the `uppercase` utility).",
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "fontSize": { "$type": "dimension", "$value": "20px" },
      "lineHeight": { "$type": "dimension", "$value": "25px" },
      "fontWeight": { "$type": "fontWeight", "$value": 700 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "headline": {
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "fontSize": { "$type": "dimension", "$value": "17px" },
      "lineHeight": { "$type": "dimension", "$value": "22px" },
      "fontWeight": { "$type": "fontWeight", "$value": 600 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "callout": {
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "fontSize": { "$type": "dimension", "$value": "16px" },
      "lineHeight": { "$type": "dimension", "$value": "21px" },
      "fontWeight": { "$type": "fontWeight", "$value": 400 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "subhead": {
      "$description": "Regular 400 by default; the 600 variant is fontWeightStrong (use font-semibold).",
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "fontSize": { "$type": "dimension", "$value": "15px" },
      "lineHeight": { "$type": "dimension", "$value": "20px" },
      "fontWeight": { "$type": "fontWeight", "$value": 400 },
      "fontWeightStrong": { "$type": "fontWeight", "$value": 600 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "footnote": {
      "$description": "Regular 400 by default; the 600 variant is fontWeightStrong (use font-semibold).",
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "fontSize": { "$type": "dimension", "$value": "13px" },
      "lineHeight": { "$type": "dimension", "$value": "18px" },
      "fontWeight": { "$type": "fontWeight", "$value": 400 },
      "fontWeightStrong": { "$type": "fontWeight", "$value": 600 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "caption": {
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "fontSize": { "$type": "dimension", "$value": "12px" },
      "lineHeight": { "$type": "dimension", "$value": "16px" },
      "fontWeight": { "$type": "fontWeight", "$value": 500 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    },
    "caption2": {
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "fontSize": { "$type": "dimension", "$value": "11px" },
      "lineHeight": { "$type": "dimension", "$value": "13px" },
      "fontWeight": { "$type": "fontWeight", "$value": 500 },
      "letterSpacing": { "$type": "dimension", "$value": "0px" }
    }
  }
}
