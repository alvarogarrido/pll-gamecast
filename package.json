{
  "name": "pll-gamecast",
  "private": true,
  "description": "Inside Lacrosse NCAA Gamecast redesign: atomic component library, production-shaped prototype, and a detached Scenario Lab.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @pll/web",
    "build": "npm run build -w @pll/web",
    "storybook": "npm run storybook -w @pll/ui",
    "build-storybook": "npm run build-storybook -w @pll/ui",
    "tokens": "npm run build -w @pll/tokens",
    "data:build": "npm run build -w @pll/data",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "node scripts/preview-site.mjs",
    "dev:lab": "node scripts/dev-lab.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
